---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import { factions } from '../../data/factions';

const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
const present = [...new Set(people.map((p) => p.data.faction))];
---
<Base title="人物" description="三国时期主要人物列传">
  <h1>人物</h1>
  <p class="muted">共收录 {people.length} 位人物。点击卡片查看生平、史实与演义的差异。</p>
  <div class="filters" role="group" aria-label="按势力筛选">
    <button type="button" data-filter="all" aria-pressed="true">全部</button>
    {present.map((id) => <button type="button" data-filter={id} aria-pressed="false">{factions[id].full}</button>)}
  </div>
  <div class="grid">
    {people.map((p) => <PersonCard person={p} />)}
  </div>
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        document.querySelectorAll<HTMLElement>('.person-card').forEach((el) => {
          el.hidden = f !== 'all' && el.dataset.faction !== f;
        });
      }),
    );
  </script>
</Base>
